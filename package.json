{
  "name": "json-schema-validator",
  "version": "1.0.0",
  "description": "Validate JSON documents against Draft 2020-12 schemas and generate TypeScript types from them.",
  "type": "module",
  "scripts": {
    "validate": "tsx src/validate.ts",
    "generate-types": "tsx src/generate-types.ts",
    "build": "tsc --noEmit"
  },
  "keywords": ["json-schema", "ajv", "validation", "typescript"],
  "license": "MIT",
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "@types/node": "^24.0.0"
  }
}
